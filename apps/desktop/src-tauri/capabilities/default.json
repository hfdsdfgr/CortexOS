{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main-window",
  "description": "Workspace-scoped local data and loopback model commands for the main window.",
  "windows": [
    "main"
  ],
  "permissions": [
    "allow-bootstrap",
    "allow-create-workspace",
    "allow-list-conversations",
    "allow-create-conversation",
    "allow-rename-conversation",
    "allow-load-messages",
    "allow-check-ollama",
    "allow-save-settings",
    "allow-get-run",
    "allow-list-runs",
    "allow-load-execution-graph",
    "allow-save-execution-view",
    "allow-preview-context",
    "allow-cancel-run",
    "allow-start-chat",
    "allow-list-knowledge",
    "allow-get-knowledge",
    "allow-save-knowledge",
    "allow-approve-knowledge",
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "core:window:allow-close",
    "allow-load-knowledge-graph",
    "allow-save-knowledge-edge",
    "allow-save-graph-view"
  ]
}
