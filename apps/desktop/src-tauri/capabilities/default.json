{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main-window",
  "description": "Workspace-scoped data, loopback model commands and integrated window controls for the main window.",
  "windows": [
    "main"
  ],
  "permissions": [
    "allow-discard-source",
    "allow-choose-source",
    "allow-commit-source",
    "allow-list-sources",
    "allow-get-source",
    "allow-revoke-source",
    "allow-save-source-knowledge",
    "allow-bootstrap",
    "allow-create-workspace",
    "allow-list-conversations",
    "allow-create-conversation",
    "allow-rename-conversation",
    "allow-load-messages",
    "allow-check-ollama",
    "allow-save-settings",
    "allow-get-run",
    "allow-list-runs",
    "allow-load-execution-graph",
    "allow-save-execution-view",
    "allow-preview-context",
    "allow-set-conversation-retrieval",
    "allow-cancel-run",
    "allow-start-chat",
    "allow-list-knowledge",
    "allow-get-knowledge",
    "allow-save-knowledge",
    "allow-approve-knowledge",
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "core:window:allow-close",
    "core:window:allow-minimize",
    "core:window:allow-toggle-maximize",
    "core:window:allow-is-maximized",
    "core:window:allow-start-dragging",
    "allow-load-knowledge-graph",
    "allow-save-knowledge-edge",
    "allow-save-graph-view"
  ]
}
