{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main-window",
  "description": "Workspace-scoped local data and loopback model commands for the main window.",
  "windows": ["main"],
  "permissions": [
    "allow-bootstrap",
    "allow-create-workspace",
    "allow-list-conversations",
    "allow-create-conversation",
    "allow-rename-conversation",
    "allow-load-messages",
    "allow-check-ollama",
    "allow-save-settings",
    "allow-get-run",
    "allow-cancel-run",
    "allow-start-chat"
  ]
}
